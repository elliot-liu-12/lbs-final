// expect-ct: reject CT-INDEX EXPLICIT-FLOW
// expect-ni: reject EXPLICIT-FLOW
// leaks: yes
// Reading a public table at a secret index leaks twice: through the address,
// and because the public result reveals which entry was read.
public int[8] tbl = {10, 20, 30, 40, 50, 60, 70, 80};
secret int key;
public int out;

out := tbl[key & 7];
